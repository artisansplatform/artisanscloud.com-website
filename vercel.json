{
    "cleanUrls": true,
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/blog-list",
            "destination": "/articles-and-resources",
            "permanent": true
        },
        {
            "source": "/retail-platform",
            "destination": "/unified-commerce",
            "permanent": true
        },
        {
            "source": "/overview",
            "destination": "/unified-commerce",
            "permanent": true
        },
        {
            "source": "/merchandise-planning",
            "destination": "/merchandise-and-assortment-planning",
            "permanent": true
        },
        {
            "source": "/assortment-planning",
            "destination": "/merchandise-and-assortment-planning",
            "permanent": true
        },
        {
            "source": "/d2c-ecommerce",
            "destination": "/d2c-eCommerce",
            "permanent": true
        },
        {
            "source": "/customer-xperience-management",
            "destination": "/customer-experience-management",
            "permanent": true
        },
        {
            "source": "/product-xperience-management",
            "destination": "/customer-experience-management",
            "permanent": true
        },
        {
            "source": "/Integrations",
            "destination": "/integrations",
            "permanent": true
        },
        {
            "source": "/about",
            "destination": "/about-us",
            "permanent": true
        },
        {
            "source": "/artificial-intelligence",
            "destination": "/enterprise-ai",
            "permanent": true
        },
        {
            "source": "/business-intelligence",
            "destination": "/data-intelligence",
            "permanent": true
        },
        {
            "source": "/headless-commerce",
            "destination": "/d2c-eCommerce",
            "permanent": true
        },
        {
            "source": "/solution",
            "destination": "/unified-commerce",
            "permanent": true
        },
        {
            "source": "/artisans-commerce-cloud",
            "destination": "/unified-commerce",
            "permanent": true
        },
        {
            "source": "/knowledge-harvester",
            "destination": "/vault-knowledge-harvester",
            "permanent": true
        }
    ],
    "crons": [
        {
            "path": "/api/cron/fetch-articles",
            "schedule": "0 6 * * *"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        }
    ]
}