{
  "name": "artisans-tailwind-css",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:tailwind": "tailwindcss -i ./assets/style/input.css -o ./assets/style/output.css --watch",
    "dev:server": "vite",
    "build": "npm-run-all build:*",
    "build:css": "tailwindcss -i ./assets/style/input.css -o ./assets/style/output.css --minify",
    "build:html": "vite build",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:static": "cp -r assets/og dist/assets/og",
    "generate:og": "node scripts/generate-og-images.js",
    "generate:cards": "node scripts/generate-team-cards.js",
    "add:card": "npm run generate:cards && npm run generate:og",
    "check:images": "node scripts/check-images.js",
    "optimize:images": "node scripts/optimize-images.js",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "preview": "vite preview",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:build": "npm run build && vitest run tests/build.test.js",
    "test:links": "vitest run tests/links.test.js",
    "test:seo": "vitest run tests/seo.test.js",
    "test:meta": "vitest run tests/pages-meta.test.js",
    "test:font": "vitest run tests/font-subset.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "update-fallback": "node scripts/update-fallback-articles.js",
    "prettier": "prettier --write .",
    "format": "prettier --write \"**/*.html\""
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/cli": "^4.0.0",
    "glob": "^13.0.0",
    "jsdom": "^27.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "satori": "^0.25.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.21",
    "vite-plugin-handlebars": "^2.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "qrcode": "^1.5.4",
    "swiper": "^12.1.0"
  }
}
